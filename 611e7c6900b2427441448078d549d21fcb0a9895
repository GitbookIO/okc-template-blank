              general, but the prepare-commit-msg\n# hook is more suited to
              it.\n#\n# SOB=$(git var GIT_AUTHOR_IDENT | sed -n
              's/^\\(.*>\\).*$/Signed-off-by: \\1/p')\n# grep -qs \"^$SOB\"
              \"$1\" || echo \"$SOB\" >> \"$1\"\n\n# This example catches
              duplicate Signed-off-by lines.\n\ntest \"\" = \"$(grep
              '^Signed-off-by: ' \"$1\" |\n\t sort | uniq -c | sed -e '/^[
