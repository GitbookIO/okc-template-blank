              status after issuing an appropriate message if\n# it wants to stop
              the commit.\n#\n# To enable this hook, rename this file to
              \"pre-commit\".\n\nif git rev-parse --verify HEAD >/dev/null
              2>&1\nthen\n\tagainst=HEAD\nelse\n\t# Initial commit: diff against
